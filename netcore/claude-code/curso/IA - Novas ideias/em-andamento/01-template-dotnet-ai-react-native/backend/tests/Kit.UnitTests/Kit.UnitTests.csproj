<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Kit.UnitTests - fast, in-memory tests.
    MUST cover domain invariants, Value Objects, Domain Validations,
    transitions, authorization/policy decisions, AI Tools contracts and
    structured-output parsing. No database, no network.
  -->

  <PropertyGroup>
    <RootNamespace>Kit.UnitTests</RootNamespace>
    <AssemblyName>Kit.UnitTests</AssemblyName>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Kit.Domain\Kit.Domain.csproj" />
    <ProjectReference Include="..\..\Kit.Application\Kit.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="FluentAssertions" />
  </ItemGroup>

</Project>