{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "Kit.Infrastructure.Persistence.Seeding": "Information",
        "Confluent.Kafka": "Error"
      }
    },
    "Enrich": [ "FromLogContext" ],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ]
  },

  "Database": {
    "Provider": "MySql",
    "Server": "localhost",
    "Port": 3306,
    "Database": "kit_db",
    "User": "kit_user",
    "Password": "",
    "AutoMigrate": false,
    "EnableRetryOnFailure": true,
    "MaxRetryCount": 5,
    "CommandTimeoutSeconds": 30
  },

  "Redis": {
    "Enabled": false,
    "ConnectionString": "localhost:6379",
    "InstanceName": "kit:"
  },

  "Jwt": {
    "Issuer": "Kit.Api",
    "Audience": "Kit.Web",
    "AccessTokenMinutes": 60,
    "RefreshTokenDays": 7
  },

  "Seed": {
    "Enabled": true,
    "Mode": "Minimal",
    "RandomSeed": 20260101
  },

  "Ai": {
    "Enabled": false,
    "Provider": "none",
    "MaxToolCallsPerExecution": 8,
    "MaxContextTokens": 32000,
    "RequireHumanApprovalForWrites": true
  },

  "Messaging": {
    "Enabled": false,
    "BootstrapServers": "localhost:9092",
    "TopicPrefix": "kit",
    "ConsumerGroup": "kit-consumer"
  },

  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  },

  "FeatureFlags": {
    "Identity": true,
    "Audit": true,
    "Notifications": true,
    "Content": false,
    "Media": false,
    "Navigation": false,
    "Ai": false,
    "Rag": false,
    "MultiTenant": false
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*"
}